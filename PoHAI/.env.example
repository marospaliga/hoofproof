# Copy to `.env` and fill in for testnet deploys. Never commit the real .env.
# Used by hardhat.config.js to reach Sepolia/Amoy.

# RPC endpoints (free public tier works for a demo)
SEPOLIA_RPC_URL=https://eth-sepolia.public.blastapi.io
AMOY_RPC_URL=https://rpc-amoy.polygon.technology

# The wallet that deploys and owns the contracts.
DEPLOYER_PRIVATE_KEY=0x...